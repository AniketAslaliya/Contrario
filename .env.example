# Contrario — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local or real secrets.

# -----------------------------------------------------------------------------
# AI — see lib/ai-provider.ts
# **`POST /api/analyze` is Gemini-only** (streaming in lib/analyze-sse.ts) — set `GEMINI_API_KEY`.
# Other helpers may use Anthropic when `AI_PROVIDER=anthropic` + `ANTHROPIC_API_KEY`.
# Demo / Vercel: `AI_PROVIDER=gemini`, `GEMINI_API_KEY`, optional `GEMINI_MODEL`.
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini

# Google AI Studio — https://aistudio.google.com/apikey (required for /api/analyze)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic — optional, for non-analyze Claude paths when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
# Canonical URL for this deployment (OAuth callbacks, cookies). No trailing slash.
# Local: http://localhost:3000 · Production: https://your-app.vercel.app (or custom domain).
# On Vercel, if unset, next.config.mjs defaults NEXTAUTH_URL to https://$VERCEL_URL.
# Custom domain in front of Vercel? Set NEXTAUTH_URL explicitly to https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth (optional — only if GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET are set)
# Google Cloud → OAuth client → Authorized redirect URIs — include both:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR_DEPLOYMENT_HOST/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# -----------------------------------------------------------------------------
# Supabase — Project Settings → API (URL must start with https://…supabase.co)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in with email magic link (no Google OAuth required):
# 1) Supabase → Authentication → Providers → enable **Email**.
# 2) Authentication → URL Configuration → add Redirect URLs:
#    http://localhost:3000/auth/callback · https://YOUR_DEPLOYMENT_HOST/auth/callback
#    Site URL = your primary app origin (local or production).
# 3) Keep NEXTAUTH_SECRET set — sessions use NextAuth JWT after Supabase verifies the link.

# Storage bucket for authenticated PDF uploads (create in Supabase → Storage)
NEXT_PUBLIC_SUPABASE_DECK_BUCKET=deck-uploads

# Optional — clamp PDF upload size on the server (bytes). Defaults to MAX_PDF_BYTES (~10MB).
# On Vercel, single-request bodies are capped (~4.5MB); set e.g. PDF_UPLOAD_MAX_BYTES=4718592 to fail fast with a clear error instead of a generic 413 from the edge.
# PDF_UPLOAD_MAX_BYTES=

# -----------------------------------------------------------------------------
# Platform (M25 API · admin analytics)
# -----------------------------------------------------------------------------
# CONTRARIO_API_KEY=          # Optional — enables POST /api/v1/analyze (Bearer or x-api-key)
# CONTRARIO_ADMIN_EMAILS=     # Comma-separated — grants /admin/stats

# -----------------------------------------------------------------------------
# Postgres — direct connection string (OPTIONAL)
# The Next.js app does not require this for the current code path; use it for
# Prisma/Drizzle, psql, or CLI tools. Copy the exact URI from Supabase Dashboard
# → Connect → (URI tab), and substitute your database password.
#
# If you see "Not IPv4 compatible", use the Session pooler connection string
# from the same Connect screen instead of the direct db.* host.
#
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# (optional — local only, never commit; use `npm run db:migrate` to apply supabase/migrations to this DB)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
