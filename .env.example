# Contrario — Environment Variables
# Copy to .env.local and fill in values

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# NextAuth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (for magic link — optional in dev, uses console output)
EMAIL_SERVER=
EMAIL_FROM=noreply@contrario.app
